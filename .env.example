# Database (PostgreSQL — Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js / NextAuth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Single fixed administrator (never commit real values)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL (used for SEO, sitemap, OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Vercel Blob for media uploads in production
BLOB_READ_WRITE_TOKEN=

# Optional: Newsletter provider webhook/API (server-side only)
NEWSLETTER_WEBHOOK_URL=

# Optional: Contact form email delivery via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO_EMAIL=
